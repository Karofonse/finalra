--- !u!114 &202401953
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 202401951}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61240c0e134c244658f3264dee4bcd4e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gemelo: {fileID: 978730362}
  pasos:
  - titulo: "Prepara el mult\xEDmetro"
    instruccion: "Gira el selector a VOLTAJE DC (V con l\xEDnea recta) en la escala
      de 20 V.\nConecta el cable NEGRO en el borne COM y el cable ROJO en el borne
      V/\u03A9."
    requiereMedicion: 0
    nodoRojo: 
    nodoNegro: GND
    anclaRoja: {fileID: 0}
    anclaNegra: {fileID: 0}
  - titulo: Voltaje en el nodo N1
    instruccion: "Ubica la sonda ROJA en el nodo N1 (uni\xF3n de R1 y R2) y la sonda
      NEGRA en GND, donde lo indican las sondas virtuales. Escribe la lectura del
      mult\xEDmetro."
    requiereMedicion: 1
    nodoRojo: N1
    nodoNegro: GND
    anclaRoja: {fileID: 2147128126}
    anclaNegra: {fileID: 1931393123}
  - titulo: Voltaje en el nodo N2
    instruccion: "Mant\xE9n la sonda NEGRA en GND y mueve la sonda ROJA al nodo N2
      (uni\xF3n de R2 y R3). Escribe la lectura."
    requiereMedicion: 1
    nodoRojo: N2
    nodoNegro: GND
    anclaRoja: {fileID: 1099146851}
    anclaNegra: {fileID: 1931393123}
  - titulo: "Voltaje en el potenci\xF3metro (N3)"
    instruccion: "Mueve la sonda ROJA al cursor del potenci\xF3metro (pin central,
      nodo N3). No gires el potenci\xF3metro mientras mides. Escribe la lectura."
    requiereMedicion: 1
    nodoRojo: N3
    nodoNegro: GND
    anclaRoja: {fileID: 2049277558}
    anclaNegra: {fileID: 1931393123}
  - titulo: "Ca\xEDda de tensi\xF3n en R2"
    instruccion: "Ahora mide entre dos nodos: sonda ROJA en N1 y sonda NEGRA en N2.
      La lectura es la ca\xEDda de tensi\xF3n sobre R2 (N1 menos N2)."
    requiereMedicion: 1
    nodoRojo: N1
    nodoNegro: N2
    anclaRoja: {fileID: 2147128126}
    anclaNegra: {fileID: 1099146851}
  toleranciaRelativa: 0.05
  toleranciaMinimaV: 0.1
