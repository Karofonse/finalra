--- !u!114 &1310076608
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1310076606}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61240c0e134c244658f3264dee4bcd4e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  gemelo: {fileID: 1168288929}
  pasos:
  - titulo: "Prepara el mult\xEDmetro"
    instruccion: "En un mult\xEDmetro real: gira el selector a VOLTAJE DC (V con
      l\xEDnea recta), escala de 20 V. Cable NEGRO en el borne COM y cable ROJO en
      el borne V/\u03A9. Aqu\xED usar\xE1s un mult\xEDmetro virtual ya configurado
      as\xED."
    requiereMedicion: 0
    nodoRojo: 
    nodoNegro: GND
  - titulo: Voltaje en el nodo N1
    instruccion: "Mide N1 respecto a tierra: sonda ROJA en N1 (uni\xF3n de R1 y R2)
      y sonda NEGRA en GND. Las gu\xEDas de color que suben y bajan muestran d\xF3nde
      va cada una."
    requiereMedicion: 1
    nodoRojo: N1
    nodoNegro: GND
  - titulo: Voltaje en el nodo N2
    instruccion: "Deja la sonda NEGRA en GND y pon la sonda ROJA en N2 (uni\xF3n
      de R2 y R3). Debe marcar cerca de la mitad de N1."
    requiereMedicion: 1
    nodoRojo: N2
    nodoNegro: GND
  - titulo: "Voltaje del potenci\xF3metro (N3)"
    instruccion: "Sonda ROJA en el cursor del potenci\xF3metro (N3) y sonda NEGRA
      en GND. Gira el potenci\xF3metro y observa c\xF3mo cambia la lectura."
    requiereMedicion: 1
    nodoRojo: N3
    nodoNegro: GND
  - titulo: "Ca\xEDda de tensi\xF3n en R2"
    instruccion: "Ahora mide entre dos nodos: sonda ROJA en N1 y sonda NEGRA en N2.
      La lectura es la ca\xEDda de tensi\xF3n sobre R2 (N1 menos N2)."
    requiereMedicion: 1
    nodoRojo: N1
    nodoNegro: N2
  - titulo: "Ca\xEDda de tensi\xF3n en R1"
    instruccion: "Sonda ROJA en 3V3 (alimentaci\xF3n) y sonda NEGRA en N1. Como las
      tres resistencias son iguales, la ca\xEDda es la misma que en R2."
    requiereMedicion: 1
    nodoRojo: 3V3
    nodoNegro: N1
  nodos:
  - id: 3V3
    ancla: {fileID: 1726948223}
  - id: N1
    ancla: {fileID: 218243543}
  - id: N2
    ancla: {fileID: 937125003}
  - id: N3
